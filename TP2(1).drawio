quad_class (INT)&lt;br&gt;
goldstein_scale (DECIMAL)" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" vertex="1"><mxGeometry x="60" y="350" width="300" height="200" as="geometry"/></mxCell><mxCell id="cameo" value="&lt;b&gt;DIM_CAMEO&lt;/b&gt;&lt;hr&gt;
