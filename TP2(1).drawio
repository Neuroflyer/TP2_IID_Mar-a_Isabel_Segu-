&lt;b&gt;PK compuesta:&lt;/b&gt; (noticia_evento_id, ubicacion_id, tipo_ubicacion)" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;align=left;verticalAlign=top;spacingTop=6;spacingLeft=8;" vertex="1"><mxGeometry x="1190" y="350" width="300" height="190" as="geometry"/></mxCell><mxCell id="e1" value="1 : N | obligatorio en NOTICIA_ACTOR" parent="1" edge="1" source="noticia" target="na"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="1 : N | obligatorio en NOTICIA_ACTOR" parent="1" edge="1" source="actor" target="na"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1 : N | obligatorio en NOTICIA_CAMEO" parent="1" edge="1" source="noticia" target="nc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="1 : N | opcional desde NOTICIA_EVENTO" parent="1" edge="1" source="cameo" target="nc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="1 : N | opcional desde NOTICIA_EVENTO" parent="1" edge="1" source="noticia" target="nu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="1 : N | obligatorio en NOTICIA_UBICACION" parent="1" edge="1" source="ubic" target="nu"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note1" value="&lt;b&gt;Decisiones de diseño&lt;/b&gt;&lt;br&gt;• GlobalEventID = llave natural de GDELT; se conserva como UNIQUE.&lt;br&gt;• noticia_evento_id = llave sustituta interna.&lt;br&gt;• Las relaciones M:N se resuelven mediante entidades asociativas con PK compuestas.&lt;br&gt;• Un evento puede tener 0..N ubicaciones y 1..N actores/CAMEO según el proceso de carga.&lt;br&gt;• CAMEO se almacena como texto para conservar códigos con ceros a la izquierda, tal como recomienda el codebook de GDELT." parent="1" style="note" vertex="1"><mxGeometry x="40" y="620" width="1450" height="135" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;MODELO OPERATIVO (OLTP) — Medio Internacional + GDELT/CAMEO&lt;/b&gt;" parent="1" style="title" vertex="1"><mxGeometry x="40" y="15" width="800" height="35" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="olap" name="02 - OLAP Estrella"><mxGraphModel><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="fact" value="&lt;b&gt;FACT_COBERTURA_EVENTO&lt;/b&gt;&lt;hr&gt;
